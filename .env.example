# Reclaimspace configuration — copy to .env and fill in values.
# See docs/CONFIGURATION.md for full reference.

# --- Plex ---
PLEX_URL=http://10.0.0.10:32400
PLEX_TOKEN=

# Plex library section keys (numeric), from /library/sections — not display titles.
PLEX_MOVIE_SECTION=
PLEX_TV_SECTION=

# --- Radarr (movies) ---
RADARR_URL=http://10.0.0.10:7878
RADARR_API_KEY=

# --- Sonarr (TV) ---
SONARR_URL=http://10.0.0.10:8989
SONARR_API_KEY=

# --- Host library roots (paths the tool must read on disk) ---
MOVIES_ROOT=/mnt/user/data/media/movies
TV_ROOT=/mnt/user/data/media/tv

# --- Path mappings: container_prefix=host_prefix;... ---
# Plex and *arr apps often use different prefixes for the same files.
PATH_MAPPINGS=/data/media/movies=/mnt/user/data/media/movies;/movies=/mnt/user/data/media/movies
TV_PATH_MAPPINGS=/data/media/tv=/mnt/user/data/media/tv;/tv=/mnt/user/data/media/tv

# --- Quarantine output (writable directory) ---
QUARANTINE_ROOT=/mnt/user/data/quarantine

# --- Appdata ---
# Container path for the appdata share (compose mounts /mnt/cache/appdata here).
APPDATA_ROOT=/appdata
# Host paths Docker reports for that share, separated by semicolons.
APPDATA_HOST_PREFIXES=/mnt/user/appdata;/mnt/cache/appdata
# Container path for migrated workspaces (compose mounts /mnt/user/data/code here).
CODE_ROOT=/code
UNRAID_API_URL=http://10.10.1.202/graphql
# Least-privilege Unraid key: DOCKER:READ_ANY. Leave blank to set it in Configuration.
UNRAID_API_KEY=
# Optional Docker socket fallback inside the container. Empty disables it.
# Do not mount docker.sock unless you accept full Docker API access.
DOCKER_SOCKET=

# --- Docker / web UI (optional) ---
# DATA_DIR=/config
# HOST_PORT=8777
# When using docker-compose defaults, set in the web UI:
#   movies_root=/media/movies
#   tv_root=/media/tv
#   quarantine_root=/quarantine
